<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="1.0" client="site" method="upgrade">
    <name>Tienda</name>
    <author>My Company</author>
    <creationDate>August 2023</creationDate>
    <copyright>Copyright (C) 2023 My Company. All rights reserved.</copyright>
    <license>http://www.gnu.org/licenses/gpl-2.0.html GNU/GPL</license>
    <authorEmail>support@mycompany.com</authorEmail>
    <authorUrl>www.mycompany.com</authorUrl>
    <version>1.0.0</version>
    <description>Tienda Description</description>
    <files>
        <filename module="mod_tienda">mod_tienda.php</filename>
        <filename>index.html</filename>
        <filename>helper.php</filename>
        <filename>LICENSE.txt</filename>
        <folder>tmpl</folder>
        <folder>lang</folder>
        <folder>css</folder>
        <folder>js</folder>
        <folder>images</folder>
    </files>
    <languages folder="lang">
        <language tag="en-GB">en-GB/en-GB.mod_tienda.ini</language>
        <language tag="en-GB">en-GB/en-GB.mod_tienda.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="display_login_form" type="radio" default="1" label="Display Login Form" description="Display Login Form Desc">
                    <option value="0">No</option>
                    <option value="1">Yes</option>
                </field>
                <field name="display_logout_form" type="radio" default="1" label="Display Logout Form" description="Display Logout Form Desc">
                    <option value="0">No</option>
                    <option value="1">Yes</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
